# No private keys belong in this service. Testnet only.
PORT=3001
QWAP_QUOTES_ENABLED=false

# Testnet-only unsigned preparation; never signs or broadcasts.
SWAP_PREPARATION_ENABLED=false

# Enables unsigned testnet liquidity deposits and withdrawals; requires QWAP_QUOTES_ENABLED=true
LIQUIDITY_PREPARATION_ENABLED=false

# QMS RPC configuration
QMS_RPC_URL=https://rpc.testnet.qms.finance
QMS_CHAIN_ID=19480

# Exact frontend origin (scheme, host, optional port). Blank disables cross-origin access.
CORS_ORIGIN=
