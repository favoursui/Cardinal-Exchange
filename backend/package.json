{
  "name": "cardinal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test apps/api/test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:deployment",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test:fork": "npm run build && node scripts/test-qwap-fork.mjs",
    "test:contracts": "node scripts/prepare-amm-artifacts.mjs && forge test --root contracts",
    "test:cardinal-fork": "npm run build && node scripts/test-cardinal-fork.mjs",
    "deployment:plan": "npm run build && node scripts/plan-testnet-deployment.mjs",
    "test:deployment": "node --test scripts/deployment-plan.test.mjs scripts/verify-deployment.test.mjs",
    "deployment:verify": "npm run build && node scripts/verify-testnet-deployment.mjs",
    "test:deployment-local": "node scripts/test-deployment-local.mjs",
    "build:contracts": "node scripts/prepare-amm-artifacts.mjs && forge build --root contracts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.7",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@uniswap/v2-core": "1.0.1",
    "@uniswap/v2-periphery": "1.1.0-beta.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
